# development أو production
APP_ENV=development

# العنوان والمنفذ اللذان يستمع عليهما الخادم
APP_HOST=127.0.0.1
APP_PORT=5002

# عناوين الواجهات المسموح لها بالاتصال (افصل بينها بفاصلة)
CORS_ORIGINS=http://localhost:5173

# رابط الاتصال بـ PostgreSQL داخل Docker
DATABASE_URL=postgres://swap_user:change_me@localhost:5433/swap_platform?sslmode=disable